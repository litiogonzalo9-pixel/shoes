# Puerto público para el servidor
PORT=5000

# Ruta o URL de la base de datos SQLite
# En servicios de contenedor con volumen persistente, usa:
DATABASE_URL=./database.sqlite

# Si usas un servicio de base de datos administrado, reemplaza con la URL apropiada.
# Ejemplo para Postgres:
# DATABASE_URL=postgres://user:password@hostname:5432/database
